# Copy to .env and fill in. Never commit real values.

# Postgres connection string — REQUIRED in production (Vercel serverless has
# a read-only filesystem, so SQLite cannot run there). Any Postgres works:
# Neon (neon.tech) and Supabase both have free tiers.
# Example: postgresql://user:password@host:5432/yapfi?sslmode=require
# When unset, the app falls back to local SQLite (data/yapfi.db) for dev.
DATABASE_URL=

# Groq API key — enables the real $YAPCP AI assistant (llama-3.3-70b-versatile).
# Without it, chat runs in DEMO mode: keyword classifier + canned answers.
GROQ_API_KEY=

# Public URL of the official X launch post users must like/comment/retweet.
# Example: https://x.com/yourhandle/status/1234567890
NEXT_PUBLIC_LAUNCH_POST_URL=

# X API v2 bearer token — enables real like/retweet/comment verification.
# Without it, task verification runs in clearly-labeled DEMO self-confirm mode.
X_BEARER_TOKEN=
